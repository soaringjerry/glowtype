# === Glowtype Configuration ===

# Host ports (change if you have conflicts)
GLOWTYPE_BACKEND_PORT_HOST=18080
GLOWTYPE_FRONTEND_PORT_HOST=18081
GLOWTYPE_RENDER_PORT_HOST=19080

# Backend API URL (for frontend to call)
VITE_API_BASE_URL=http://backend:8080/api/v1

# === AI Configuration (OpenAI-compatible API) ===
# Works with: OpenAI, Claude, DeepSeek, Groq, local LLMs, etc.

# Your API Key (required)
AI_API_KEY=

# API Base URL (default: OpenAI)
# Examples:
#   OpenAI:    https://api.openai.com/v1
#   DeepSeek:  https://api.deepseek.com/v1
#   Groq:      https://api.groq.com/openai/v1
#   Claude:    https://api.anthropic.com/v1
#   Local:     http://localhost:11434/v1
AI_API_URL=https://api.openai.com/v1

# Model name
# Examples: gpt-4o-mini, gpt-4o, deepseek-chat, llama-3.1-70b-versatile
AI_MODEL=gpt-4o-mini

# === Admin Configuration ===
# Password for admin panel (accessible at /admin)
ADMIN_PASSWORD=your_secure_password_here
# 2FA encryption key (exactly 32 chars, required to enable TOTP)
TOTP_ENCRYPTION_KEY=please_set_a_32_char_secret_here
# Globally force all admins to enable 2FA (optional)
FORCE_ADMIN_2FA=false

# === Database ===
# Auto-seed example data on first run (set to false after initial setup)
SEED_DB=true
